# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo.toml-vs-cargo.lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# OSX
.DS_Store

# Editor artifacts
.idea
.vscode
*.swp
*.swo

# WebAssembly build artifacts (if any are generated directly into a folder)
# Usually these go into pkg/ or out/ but if out/ contains manual HTML we might not want to ignore the whole folder.
# We will ignore common generated wasm files if they appear in root
*.wasm
